#!/bin/bash

# Повністю автономний скрипт встановлення Stirling PDF для чистої Ubuntu.
# Сумісний із запуском через curl | sudo bash БЕЗ інтерактивних запитів.

# Зупиняти скрипт при будь-якій помилці
set -e

# 1. Перевірка на права суперкористувача (щоб уникнути зависання sudo всередині скрипту)
if [ "$EUID" -ne 0 ]; then
  echo "Помилка: Цей скрипт потрібно запускати від імені root (через sudo bash)."
  exit 1
fi

# 2. Блокування будь-яких інтерактивних вікон Ubuntu (Needrestart, Grids тощо)
export DEBIAN_FRONTEND=noninteractive
export NEEDRESTART_MODE=a

echo "=== 1. Оновлення джерел та встановлення базового Docker ==="
apt-get update -y
apt-get install -y docker.io curl wget

# Запуск та додавання Docker в автозапуск системи
systemctl enable --now docker

echo "=== 2. Пряме завантаження Docker Compose ==="
mkdir -p /usr/lib/docker/cli-plugins

# Очищаємо старі невдалі завантаження, якщо вони були
rm -f /usr/lib/docker/cli-plugins/docker-compose
rm -f /usr/local/bin/docker-compose

# Завантажуємо стабільний x86_64 реліз за допомогою wget, який ідеально обробляє редіректи GitHub
wget -q --show-progress -O /usr/lib/docker/cli-plugins/docker-compose "https://github.com"
chmod +x /usr/lib/docker/cli-plugins/docker-compose

# Робимо системний лінк, щоб працював і варіант з дефісом "docker-compose"
ln -sf /usr/lib/docker/cli-plugins/docker-compose /usr/local/bin/docker-compose

echo "=== 3. Створення структури папок ==="
# Визначаємо домашню директорію реального користувача (не root) для збереження файлів
REAL_USER_HOME=$(eval echo "~${SUDO_USER:-$USER}")
TARGET_DIR="$REAL_USER_HOME/stirling-pdf"

mkdir -p "$TARGET_DIR"/stirling-data/{tessdata,configs,logs,pipeline}
cd "$TARGET_DIR"

echo "=== 4. Завантаження мовного пакета для українського OCR ==="
wget -q -O "$TARGET_DIR/stirling-data/tessdata/ukr.traineddata" "https://github.com"

echo "=== 5. Генерація файлу docker-compose.yml ==="
# Надійне форматування тексту через printf для стрімінгу
printf "%s\n" \
"services:" \
"  stirling-pdf:" \
"    image: stirlingtools/stirling-pdf:latest" \
"    container_name: stirling-pdf" \
"    restart: unless-stopped" \
"    ports:" \
"      - \"8080:8080\"" \
"    volumes:" \
"      - ./stirling-data/tessdata:/usr/share/tessdata/tessdata" \
"      - ./stirling-data/configs:/configs" \
"      - ./stirling-data/logs:/logs" \
"      - ./stirling-data/pipeline:/pipeline" \
"    environment:" \
"      - SYSTEM_DEFAULTLOCALE=uk-UA" \
"      - LANGS=uk_UA,en_US" \
"      - SECURITY_ENABLELOGIN=true" \
"      - DISABLE_ADDITIONAL_FEATURES=false" \
"      - SECURITY_CSRF_DISABLED=false" \
"      - JAVA_TOOL_OPTIONS=-Xmx2g" > docker-compose.yml

echo "=== 6. Запуск Stirling PDF в Docker ==="
/usr/local/bin/docker-compose up -d

echo "=========================================================="
echo " ВСТАНОВЛЕННЯ УСПІШНО ЗАВЕРШЕНО!"
echo " Папка з конфігураціями: $TARGET_DIR"
echo " Stirling PDF доступний за адресою: http://$(curl -s ifconfig.me):8080"
echo " "
echo " Логін за замовчуванням: admin"
echo " Пароль за замовчуванням: stirling"
echo "=========================================================="
