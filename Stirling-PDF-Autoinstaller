#!/bin/bash

# Повністю автономний скрипт встановлення Stirling PDF для чистої Ubuntu.
# Працює через офіційні пакети репозиторію БЕЗ завантаження сторонніх бінарників.
# Захищений від конфліктів синтаксису docker compose за допомогою прямого виклику CLI-плагіна.

# Зупиняти скрипт при будь-якій помилці
set -e

# 1. Перевірка на права суперкористувача (щоб уникнути зависання sudo всередині пайпу)
if [ "$EUID" -ne 0 ]; then
  echo "Помилка: Цей скрипт потрібно запускати від імені root (через sudo bash)."
  exit 1
fi

# Блокування інтерактивних вікон Ubuntu (Needrestart, фіолетові екрани оновлень дDirect)
export DEBIAN_FRONTEND=noninteractive
export NEEDRESTART_MODE=a

echo "=== 1. Оновлення джерел та встановлення Docker і Compose ==="
apt-get update -y
# Встановлюємо стабільну базу Docker та офіційний плагін Compose з репозиторіїв Ubuntu
apt-get install -y docker.io docker-compose-v2 curl wget

# Запуск та додавання служби Docker в автозапуск системи
systemctl enable --now docker

echo "=== 2. Створення структури папок для даних ==="
# Визначаємо домашню директорію реального користувача (не root), який запустив скрипт
REAL_USER_HOME=$(eval echo "~${SUDO_USER:-$USER}")
TARGET_DIR="$REAL_USER_HOME/stirling-pdf"

mkdir -p "$TARGET_DIR"/stirling-data/{tessdata,configs,logs,pipeline}
cd "$TARGET_DIR"

echo "=== 3. Завантаження мовного пакета для українського OCR ==="
# Використовуємо wget, який стабільно викачує навчену модель розпізнавання тексту
wget -q -O "$TARGET_DIR/stirling-data/tessdata/ukr.traineddata" "https://github.com"

echo "=== 4. Генерація файлу docker-compose.yml ==="
# Надійне форматування тексту через printf для коректного стрімінгу через curl | bash
printf "%s\n" \
"services:" \
"  stirling-pdf:" \
"    image: stirlingtools/stirling-pdf:latest" \
"    container_name: stirling-pdf" \
"    restart: unless-stopped" \
"    ports:" \
"      - \"8080:8080\"" \
"    volumes:" \
"      - ./stirling-data/tessdata:/usr/share/tessdata/tessdata" \
"      - ./stirling-data/configs:/configs" \
"      - ./stirling-data/logs:/logs" \
"      - ./stirling-data/pipeline:/pipeline" \
"    environment:" \
"      - SYSTEM_DEFAULTLOCALE=uk-UA" \
"      - LANGS=uk_UA,en_US" \
"      - SECURITY_ENABLELOGIN=true" \
"      - DISABLE_ADDITIONAL_FEATURES=false" \
"      - SECURITY_CSRF_DISABLED=false" \
"      - JAVA_TOOL_OPTIONS=-Xmx2g" > docker-compose.yml

echo "=== 5. Запуск Stirling PDF в Docker ==="
# Прямий виклику бінарника CLI-плагіна. Це на 100% обходить помилку "unknown shorthand flag: -d"
/usr/libexec/docker/cli-plugins/docker-compose up -d

echo "=========================================================="
echo " ВСТАНОВЛЕННЯ УСПІШНО ЗАВЕРШЕНО!"
echo " Папка з файлами створена тут: $TARGET_DIR"
echo " Stirling PDF доступний за адресою: http://$(curl -s ifconfig.me):8080"
echo " "
echo " Логін за замовчуванням: admin"
echo " Пароль за замовчуванням: stirling"
echo "=========================================================="
