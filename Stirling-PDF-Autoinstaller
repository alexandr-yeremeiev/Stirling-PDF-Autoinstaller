#!/bin/bash

# Скрипт автоматичного встановлення Stirling PDF для Ubuntu (Сумісний із curl | sudo bash)
# Повністю очищає старі контейнери та обходить помилки APT.

# Зупиняти скрипт при помилках
set -e

echo "=== 1. Очищення старих контейнерів та конфліктів ==="
# Якщо контейнер вже існує або працює — зупиняємо та видаляємо його
sudo docker stop stirling-pdf 2>/dev/null || true
sudo docker rm stirling-pdf 2>/dev/null || true

echo "=== 2. Оновлення системи та встановлення базового Docker ==="
sudo apt update
# Встановлюємо чистий docker.io БЕЗ проблемного апт-плагіна compose
sudo apt install -y docker.io curl wget

# Запуск та додавання Docker в автозапуск
sudo systemctl enable --now docker

echo "=== 3. Пряме завантаження стабільного Docker Compose з GitHub ==="
sudo mkdir -p /usr/lib/docker/cli-plugins

# Завантажуємо актуальний бінарник Compose напряму з офіційних релізів Docker
COMPOSE_VERSION=$(curl -s https://github.com | grep -Po '"tag_name": "\K[^"]*')

echo "Завантажуємо Docker Compose версії $COMPOSE_VERSION..."
sudo curl -SL "https://github.com{COMPOSE_VERSION}/docker-compose-linux-$(uname -m)" -o /usr/lib/docker/cli-plugins/docker-compose
sudo chmod +x /usr/lib/docker/cli-plugins/docker-compose

echo "=== 4. Створення структури папок для даних ==="
# Визначаємо домашню директорію реального користувача, навіть під sudo
REAL_USER_HOME=$(eval echo "~${SUDO_USER:-$USER}")
TARGET_DIR="$REAL_USER_HOME/stirling-pdf"

mkdir -p "$TARGET_DIR"/stirling-data/{tessdata,configs,logs,pipeline}
cd "$TARGET_DIR"

echo "=== 5. Завантаження мовного пакета для українського OCR ==="
UKR_DATA_URL="https://github.com"
wget -O "$TARGET_DIR/stirling-data/tessdata/ukr.traineddata" "$UKR_DATA_URL"

echo "=== 6. Генерація файлу docker-compose.yml ==="
# Використовуємо надійний printf замість cat << EOF для сумісності з curl | bash
printf '%s\n' \
"services:" \
"  stirling-pdf:" \
"    image: stirlingtools/stirling-pdf:latest" \
"    container_name: stirling-pdf" \
"    restart: unless-stopped" \
"    ports:" \
"      - \"8080:8080\"" \
"    volumes:" \
"      - ./stirling-data/tessdata:/usr/share/tessdata" \
"      - ./stirling-data/configs:/configs" \
"      - ./stirling-data/logs:/logs" \
"      - ./stirling-data/pipeline:/pipeline" \
"    environment:" \
"      - SYSTEM_DEFAULTLOCALE=uk-UA" \
"      - LANGS=uk_UA,en_US" \
"      - SECURITY_ENABLELOGIN=true" \
"      - DISABLE_ADDITIONAL_FEATURES=false" \
"      - SECURITY_CSRF_DISABLED=false" \
"      - JAVA_TOOL_OPTIONS=-Xmx2g" > docker-compose.yml

echo "=== 7. Запуск Stirling PDF в Docker ==="
sudo docker compose up -d

echo "=========================================================="
echo " Встановлення успішно завершено!"
echo " Папка з файлами створена тут: $TARGET_DIR"
echo " Stirling PDF доступний за адресою: http://$(curl -s ifconfig.me):8080"
echo " "
echo " Стандартні дані для першого входу:"
echo " Логін: admin"
echo " Пароль: stirling"
echo "=========================================================="
echo "!!! Увага: Обов'язково змініть пароль в адмін-панелі !!!"
