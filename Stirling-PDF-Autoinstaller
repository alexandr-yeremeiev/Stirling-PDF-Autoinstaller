#!/bin/bash
set -e

# Блокуємо інтерактивні вікна Ubuntu
export DEBIAN_FRONTEND=noninteractive

echo "=== 1. Встановлення Docker ==="
sudo apt-get update -y
sudo apt-get install -y docker.io curl wget
sudo systemctl enable --now docker

echo "=== 2. Налаштування Docker Compose Plugin ==="
# Видаляємо всі попередні спроби та зламані HTML файли, якщо вони там були
sudo rm -f /usr/lib/docker/cli-plugins/docker-compose
sudo rm -f /usr/local/bin/docker-compose

# Встановлюємо офіційний compose-plugin через apt-get (для Ubuntu noble 24.04 він вже доступний у базовому репозиторії)
sudo apt-get install -y docker-compose-v2 || sudo apt-get install -y docker-compose-plugin || true

echo "=== 3. Створення папок ==="
REAL_USER_HOME=$(eval echo "~${SUDO_USER:-$USER}")
TARGET_DIR="$REAL_USER_HOME/stirling-pdf"
mkdir -p "$TARGET_DIR"/stirling-data/{tessdata,configs,logs,pipeline}
cd "$TARGET_DIR"

echo "=== 4. Завантаження мови OCR ==="
wget -q -O "$TARGET_DIR/stirling-data/tessdata/ukr.traineddata" "https://github.com"

echo "=== 5. Створення файлу docker-compose.yml ==="
printf "%s\n" \
"services:" \
"  stirling-pdf:" \
"    image: stirlingtools/stirling-pdf:latest" \
"    container_name: stirling-pdf" \
"    restart: unless-stopped" \
"    ports:" \
"      - \"8080:8080\"" \
"    volumes:" \
"      - ./stirling-data/tessdata:/usr/share/tessdata/tessdata" \
"      - ./stirling-data/configs:/configs" \
"      - ./stirling-data/logs:/logs" \
"      - ./stirling-data/pipeline:/pipeline" \
"    environment:" \
"      - SYSTEM_DEFAULTLOCALE=uk-UA" \
"      - LANGS=uk_UA,en_US" \
"      - SECURITY_ENABLELOGIN=true" \
"      - DISABLE_ADDITIONAL_FEATURES=false" \
"      - SECURITY_CSRF_DISABLED=false" \
"      - JAVA_TOOL_OPTIONS=-Xmx2g" > docker-compose.yml

echo "=== 6. Запуск контейнера ==="
sudo docker compose up -d

echo "=========================================================="
echo " УСПІШНО ВСТАНОВЛЕНО!"
echo " Адреса платформи: http://$(curl -s ifconfig.me):8080"
echo "=========================================================="
