#!/bin/bash

# Скрипт автоматичного встановлення Stirling PDF для Ubuntu
# Виправлено помилку з невидимим репозиторієм docker-compose-plugin

set -e

echo "=== 1. Видалення конфліктних старих пакетів ==="
for pkg in docker.io docker-doc docker-compose docker-compose-v2 podman-docker containerd runc; do 
  sudo apt remove -y "$pkg" 2>/dev/null || true 
done

echo "=== 2. Встановлення базових утиліт та налаштування ключів ==="
sudo apt update
sudo apt install -y ca-certificates curl gnupg

# Створюємо папку для ключів та завантажуємо офіційний ключ Docker
sudo mkdir -p /etc/apt/keyrings
curl -fsSL https://docker.com | sudo gpg --dearmor --yes -o /etc/apt/keyrings/docker.gpg
sudo chmod a+r /etc/apt/keyrings/docker.gpg

echo "=== 3. Додавання стабільного репозиторію Docker ==="
# Визначаємо версію Ubuntu (jammy, noble тощо)
UBUNTU_CODENAME=$(. /etc/os-release && echo "$VERSION_CODENAME")

echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://docker.com ${UBUNTU_CODENAME} stable" | \
  sudo tee /etc/apt/sources.list.d/docker.list > /dev/null

echo "=== 4. Встановлення Docker Engine та Docker Compose Plugin ==="
# Обов'язково робимо update, щоб система побачила новий репозиторій
sudo apt update -y
sudo apt install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin wget

# Запуск та додавання Docker в автозапуск
sudo systemctl enable --now docker

echo "=== 5. Створення структури папок для даних ==="
TARGET_DIR="$HOME/stirling-pdf"
mkdir -p "$TARGET_DIR"/stirling-data/{tessdata,configs,logs,pipeline}
cd "$TARGET_DIR"

echo "=== 6. Завантаження мовного пакета для українського OCR ==="
UKR_DATA_URL="https://github.com"
wget -O "$TARGET_DIR/stirling-data/tessdata/ukr.traineddata" "$UKR_DATA_URL"

echo "=== 7. Створення конфігурації docker-compose.yml ==="
cat << 'EOF' > docker-compose.yml
services:
  stirling-pdf:
    image: stirlingtools/stirling-pdf:latest
    container_name: stirling-pdf
    restart: unless-stopped
    ports:
      - "8080:8080"
    volumes:
      - ./stirling-data/tessdata:/usr/share/tessdata
      - ./stirling-data/configs:/configs
      - ./stirling-data/logs:/logs
      - ./stirling-data/pipeline:/pipeline
    environment:
      - SYSTEM_DEFAULTLOCALE=uk-UA
      - LANGS=uk_UA,en_US
      - SECURITY_ENABLELOGIN=true
      - DISABLE_ADDITIONAL_FEATURES=false
      - SECURITY_CSRF_DISABLED=false
      - JAVA_TOOL_OPTIONS=-Xmx2g
EOF

echo "=== 8. Запуск Stirling PDF в Docker ==="
docker compose up -d

echo "=========================================================="
echo " Встановлення успішно завершено!"
echo " Stirling PDF доступний за адресою: http://$(curl -s ifconfig.me):8080"
echo " "
echo " Стандартні дані для першого входу:"
echo " Логін: admin"
echo " Пароль: stirling"
echo "=========================================================="
echo "!!! Увага: Обов'язково змініть пароль в адмін-панелі !!!"
